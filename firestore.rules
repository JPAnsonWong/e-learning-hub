rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 只有家庭共用帳號可以讀寫；其餘全部拒絕（Admin SDK 不受規則限制，供 Notion 同步使用）
    function isFamily() {
      return request.auth != null && request.auth.token.email == 'family@elh.app';
    }
    match /students/{sid}/materials/{mid} {
      allow read, write: if isFamily();
    }
    match /sessions/{sessionId} {
      allow read, write: if isFamily();
    }
    // ---- 每日打卡 ----
    // 打卡任務由同步程式（Admin）建立；網站只能切換「打卡」狀態，不能新增、刪除，也不能改分數、標題。
    match /checkins/{id} {
      allow read: if isFamily();
      allow update: if isFamily()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'updatedAt'])
        && request.resource.data.done is bool
        && (request.resource.data.doneAt == null || request.resource.data.doneAt is number);
      allow create, delete: if false;
    }
    match /countdowns/{id} { allow read: if isFamily(); }
    match /checkin_totals/{id} { allow read: if isFamily(); }

    // ---- 獎勵兌換 ----
    // 獎勵清單由同步程式（Admin）從 Notion 寫入；孩子只能「提出申請」（狀態固定為 pending，積分必須和獎勵清單一致），
    // 批准或拒絕由爸爸在 Notion 決定，網站不能改、不能刪。
    match /rewards/{id} { allow read: if isFamily(); }
    match /redemptions/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.keys().hasOnly(['student', 'rewardId', 'name', 'icon', 'cost', 'status', 'date', 'requestedAt', 'note', 'page'])
        && request.resource.data.status == 'pending'
        && request.resource.data.student in ['daughter', 'son']
        && request.resource.data.cost is number && request.resource.data.cost > 0
        && exists(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId))
        && get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.cost == request.resource.data.cost;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
